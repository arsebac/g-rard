DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/gerard
SESSION_SECRET=changeme_use_a_random_32_char_string
UPLOAD_DIR=./uploads
PORT=3000
NODE_ENV=development
GERARD_API_KEY=change-me-in-production
# User an API-key request acts as when it sends no x-user-id header (duckies-hub does not).
# Leave empty to refuse such requests.
GERARD_API_DEFAULT_USER_ID=
# Self-service sign-up on the login page. Leave false: use `npm run create-user -w server` instead.
ALLOW_REGISTRATION=false
# Cloudflare Access (optional). Leave unset to keep password sessions only.
# CF_ACCESS_AUD is the Application Audience tag of the Access application.
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# Comma-separated when more than one Access application fronts this deployment
# (for example a wildcard for the web app and a path-scoped one for /mcp).
CF_ACCESS_AUD=first_application_audience_tag,second_application_audience_tag
